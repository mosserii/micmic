# MicMic listener settings. One NAME=value per line, no quotes.
# Uncomment what you need, then restart the app. See README.md.
#
# MICMIC_SERVER=http://127.0.0.1:8799
# MICMIC_LOCALE=he-IL
# MICMIC_DEBUG=1
# MICMIC_ON_DEVICE=0
# MICMIC_PYTHON=/path/to/python3

# Real message sending, which you asked for. The server the app starts inherits this.
# Every send is still read back to you first with a cancel window; nothing goes out
# silently.
MICMIC_ALLOW_SEND=1

# Real phone calls stay OFF until you deliberately turn them on. This also gates the
# emergency call: with it off MicMic says out loud that calling is switched off rather
# than pretending to dial. Uncomment when you want it live.
# MICMIC_ALLOW_CALL=1
